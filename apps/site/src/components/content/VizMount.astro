---
// 본문의 figure[data-viz] 를 화면에 보일 때 시각화 컴포넌트로 채운다 (client:visible 과 같은 동작)
// ClientRouter 로 페이지를 옮겨도 새 문서에서 다시 찾고, 떠나는 페이지의 것은 정리한다
---

<script>
  import { observeViz, siteLoader } from '@/viz/mount'
  import { HtmlDemoMessage } from '@/lib/remark/html-demo'
  let stop: (() => void) | undefined
  document.addEventListener('astro:page-load', () => {
    stop?.()
    stop = observeViz(document, siteLoader)
  })
  document.addEventListener('astro:before-swap', () => {
    stop?.()
    stop = undefined
  })
  // html demo iframe (티스토리 HTML 삽입) 이 알려 준 높이로 맞춘다 : 보낸 iframe 만 찾는다
  addEventListener('message', (e) => {
    const D = e.data as { type?: string; height?: unknown } | null
    if (!D || D.type !== HtmlDemoMessage || typeof D.height !== 'number') return
    for (const F of document.querySelectorAll<HTMLIFrameElement>('figure.html-demo iframe')) {
      if (F.contentWindow === e.source) F.style.height = `${Math.min(Math.max(D.height, 40), 2000)}px`
    }
  })
</script>

---
import { getPosts } from '@/lib/content/posts'
import { getCollection, render } from 'astro:content'
import Layout from '@/sections/posts/Layout.astro'
// 확장자를 붙인다 : 윈도우는 대소문자를 구분하지 않는다
import ArticleDesk from '@/sections/posts/ArticleDesk.tsx'
import { folderOf, stripStep, type DeskPost } from '@/sections/posts/desk'
import Article from '@/components/content/Article.astro'
import PostArticle from '@/sections/posts/PostArticle.astro'
import LinkList from '@/components/content/LinkList.astro'
import VizMount from '@/components/content/VizMount.astro'
import { formatDate, getSiteGraph } from '@/lib/content/site-graph'

export async function getStaticPaths() {
  return (await getPosts()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const Graph = await getSiteGraph()
const Related = Graph.related(entry.id).map((n) => ({ href: `/wiki/${n.slug}`, title: n.title }))
const Meta = [{ text: formatDate(entry.data.date) }, { text: entry.data.source, href: entry.data.originalUrl }]

// 컴퓨터 글은 기술 블로그 바탕화면 창 안에서 읽는다 : 폴더 목록 · 글 수는 목록 화면과 같은 기준
const OnDesk = entry.data.field === 'computer'
const Computer = OnDesk ? await getPosts((p) => p.data.field === 'computer') : []
const DeskPosts: DeskPost[] = Computer.map((p) => ({ id: p.id, title: p.data.title, date: formatDate(p.data.date), topic: p.data.topic, tags: [], summary: '' }))

// 깃블로그 글 화면의 시리즈 목록 · 이전 / 다음 : 같은 시리즈 글을 step (없으면 날짜) 순서로
const SeriesName = entry.data.series
const SeriesPosts = SeriesName
  ? Computer.filter((p) => p.data.series === SeriesName).sort((a, b) => (a.data.step ?? 0) - (b.data.step ?? 0) || a.data.date.getTime() - b.data.date.getTime())
  : []
const Series = SeriesName ? { name: SeriesName, items: SeriesPosts.map((p) => ({ title: stripStep(p.data.title), href: p.id === entry.id ? undefined : `/posts/${p.id}/` })) } : undefined

// 이전 / 다음 글 : 같은 책 (시리즈) 순서, 책이 없으면 같은 폴더의 날짜 순서
const MyFolder = folderOf(entry.data.topic)
const Siblings = SeriesName
  ? SeriesPosts
  : Computer.filter((p) => !p.data.series && folderOf(p.data.topic) === MyFolder).sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
const Here = Siblings.findIndex((p) => p.id === entry.id)
const toLink = (p: (typeof Siblings)[number] | undefined) => (p ? { href: `/posts/${p.id}/`, title: stripStep(p.data.title) } : undefined)
const Prev = Here > 0 ? toLink(Siblings[Here - 1]) : undefined
const Next = Here >= 0 ? toLink(Siblings[Here + 1]) : undefined
---

<Layout>
  {
    OnDesk ? (
      <ArticleDesk posts={DeskPosts} title={entry.data.title} topic={entry.data.topic} series={entry.data.series} prev={Prev} next={Next}>
        <PostArticle
          title={stripStep(entry.data.title)}
          date={formatDate(entry.data.date)}
          tags={entry.data.tags}
          source={entry.data.source}
          originalUrl={entry.data.originalUrl}
          series={Series}
          prev={Prev}
          next={Next}
          related={Related}
        >
          <Content />
        </PostArticle>
      </ArticleDesk>
    ) : (
      <Article title={entry.data.title} meta={Meta}>
        <Content />
        <LinkList slot="after" heading="관련 개념" items={Related} />
      </Article>
    )
  }
  <VizMount />
</Layout>

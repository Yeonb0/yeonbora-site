---
import { getCollection } from 'astro:content'
import Layout from '@/sections/posts/Layout.astro'
// 확장자를 붙인다 : 윈도우는 대소문자를 구분하지 않는다
import Desktop from '@/sections/posts/Desktop.tsx'
import { summarize, type DeskPost } from '@/sections/posts/desk'
import { formatDate } from '@/lib/content/site-graph'

// 기술 블로그에는 컴퓨터 글만 놓는다 : 인문 글은 /humanities/ 도서관이 맡는다
const Posts: DeskPost[] = (await getCollection('posts', (p) => p.data.field === 'computer')).map((p) => ({
  id: p.id,
  title: p.data.title,
  date: formatDate(p.data.date),
  topic: p.data.topic,
  series: p.data.series,
  step: p.data.step,
  tier: p.data.tier,
  tags: p.data.tags,
  summary: p.data.description ?? summarize(p.body ?? ''),
}))
---

<Layout>
  <Desktop client:only="react" posts={Posts} />
</Layout>

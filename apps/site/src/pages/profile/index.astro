---
import Layout from '@/sections/profile/Layout.astro'
import { Me, Stack, Projects, Activities, Contact, type Row } from '@/sections/profile/data'

const Sections: { title: string; rows: Row[] }[] = [
  { title: 'STACK', rows: Stack },
  { title: 'PROJECTS', rows: Projects },
  { title: 'ACTIVITIES', rows: Activities },
]
---

<Layout>
  <h1>{Me.name}</h1>
  <p class="handle">{Me.handle}</p>
  <p class="motto">{Me.motto}</p>
  <p class="intro">{Me.intro}</p>
  {
    Sections.map((s) => (
      <section>
        <h2>{s.title}</h2>
        <ul class="list">
          {s.rows.map((r) =>
            r.href ? (
              <li>
                <a href={r.href} target="_blank" rel="noopener">
                  <span class="k">{r.k}</span>
                  <span class="v">{r.v}</span>
                </a>
              </li>
            ) : (
              <li>
                <span class="k">{r.k}</span>
                <span class="v">{r.v}</span>
              </li>
            ),
          )}
        </ul>
      </section>
    ))
  }
  <section>
    <h2>CONTACT</h2>
    <div class="contact">
      {
        Contact.map((c) => (
          <a href={c.href} target={c.href?.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {c.v}
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  h1 {
    margin: 0;
    font-family: var(--font-point);
    font-weight: 400;
    font-size: clamp(34px, 4.2vw, 52px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0;
  }
  .handle {
    margin-top: 6px;
    font-size: 15px;
    color: var(--profile-dim);
  }
  .motto {
    margin-top: 28px;
    font-family: var(--font-point);
    font-size: 15px;
    letter-spacing: 0.24em;
    color: var(--profile-accent);
  }
  .intro {
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.85;
  }
  h2 {
    margin: 56px 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--profile-rule);
    font-family: var(--font-point);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--profile-accent);
  }
  .list {
    list-style: none;
    display: grid;
    gap: 4px;
    margin: 0 -14px;
    padding: 0;
  }
  /* 호버하면 줄 전체가 옅게 칠해지고, 이름은 노랑 · 설명은 흰색으로 밝아진다 */
  li {
    border-radius: 6px;
    transition: background 0.35s var(--profile-ease);
  }
  li > a,
  li:not(:has(a)) {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    column-gap: 16px;
    padding: 9px 14px;
    color: inherit;
    text-decoration: none;
  }
  li:is(:hover, :focus-within) {
    background: var(--profile-row);
  }
  .k {
    font-family: var(--font-point);
    transition: color 0.35s var(--profile-ease);
  }
  .v {
    color: var(--profile-dim);
    transition: color 0.35s var(--profile-ease);
  }
  li:is(:hover, :focus-within) .k {
    color: var(--profile-accent);
  }
  li:is(:hover, :focus-within) .v {
    color: var(--fg);
  }
  a:focus-visible {
    outline: none;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    font-family: var(--font-point);
  }
  .contact a {
    padding-bottom: 2px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--profile-rule);
    transition:
      color 0.3s var(--profile-ease),
      border-color 0.3s var(--profile-ease);
  }
  .contact a:is(:hover, :focus-visible) {
    color: var(--profile-accent);
    border-color: var(--profile-accent);
    outline: none;
  }
  @media (max-width: 760px) {
    li > a,
    li:not(:has(a)) {
      grid-template-columns: 1fr;
    }
  }
</style>

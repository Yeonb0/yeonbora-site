---
// algo 섹션 전용 레이아웃 : 허브 아이콘이 이 화면 전체로 확대되며 넘어온다
import Base from '@/shared/Base.astro'
import { findSection } from '@/sections/registry'
import './tokens.css'
import './home.css'

const Me = findSection('algo')
---

<Base title={`${Me.label} · 연보라`}>
  <Fragment slot="home">
    <span class="home-flower" aria-hidden="true">
      <svg viewBox="0 0 76 76">
        <g class="petals">
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#f7a8c8" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#c9b3ff" transform="rotate(45 38 38)" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#a8d8ff" transform="rotate(90 38 38)" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#ffd1a8" transform="rotate(135 38 38)" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#f7a8c8" transform="rotate(180 38 38)" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#c9b3ff" transform="rotate(225 38 38)" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#a8d8ff" transform="rotate(270 38 38)" />
          <ellipse cx="38" cy="18" rx="9" ry="15" fill="#ffd1a8" transform="rotate(315 38 38)" />
        </g>
        <circle cx="38" cy="38" r="14" fill="#ffe7a3" />
        <g transform="translate(29 29) scale(0.75)" fill="none" stroke="#6a4a1a" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M3 11l9-7 9 7" /><path d="M5.5 9.5V20h13V9.5" /></g>
      </svg>
    </span>
    <span class="home-notion"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7" /><path d="M5.5 9.5V20h13V9.5" /><path d="M10 20v-5h4v5" /></svg></span>
  </Fragment>
  <!-- 허브에서 막 들어왔는지 (이 방의 기록 깊이가 아직 없음) : 목록에서 돌아오거나 뒤로가기면 꽃밭을 바로 보인다 -->
  <script is:inline>
    document.documentElement.toggleAttribute('data-enter-hub', history.state?.algoDepth === undefined)
  </script>
  <main class="section-algo" transition:name={`section-${Me.id}`}>
    <slot />
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-base);
  }
  /* 허브에서 들어올 때 : 섬이 풀밭을 다 그릴 때까지 허브 칸 색 그대로 둔다 (섬도 같은 색 막을 덮고 있다가 가운데부터 걷는다) */
  :global(html[data-enter-hub]) main {
    background: var(--enter-from);
  }
  :global(::view-transition-group(section-algo)),
  :global(::view-transition-old(section-algo)),
  :global(::view-transition-new(section-algo)) {
    animation-duration: 0.6s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* 허브로 돌아갈 때 꽃밭 그림이 칸 비율에 맞춰 잘리게 한다 (비율을 지키느라 칸 밖으로 삐져나오지 않게) */
  :global(::view-transition-group(section-algo)) {
    overflow: clip;
  }
  :global(::view-transition-old(section-algo)),
  :global(::view-transition-new(section-algo)) {
    height: 100%;
    object-fit: cover;
  }
</style>

---
// 허브 : 화면을 6칸 (데스크톱 3 x 2, 모바일 2 x 3) 으로 나누고 섹션 아이콘만 둔다
// 호버한 칸은 그 섹션의 색으로 칠해지고 같은 행 · 열이 함께 부드럽게 넓어진다
// grid 트랙 보간은 브라우저마다 지원이 달라 flex-grow 전환으로 구현한다
import Base from '@/shared/Base.astro'
import { HubSections, findSection } from '@/sections/registry'
import './tokens.css'

const Rows = [HubSections.slice(0, 3), HubSections.slice(3, 6)]
// 가장자리 입구 : 아래는 프로필, 왼쪽은 블로그 (위 인문 · 아래 기술로 나뉜 화면이 가득 찬다)
const Profile = findSection('profile')
const Humanities = findSection('humanities')
// 기술 블로그 : 따로 섹션이 생기기 전까지는 서재 (모든 글 목록) 로 보낸다
const Posts = findSection('posts')
const Blogs = [
  { id: Humanities.id, label: Humanities.label, en: Humanities.en, href: Humanities.href, fill: '#3a2a1c', tint: '#e3c27a', icon: Humanities.icon },
  { id: 'tech', label: '기술 블로그', en: 'Tech', href: Posts.href, fill: Posts.fill, tint: Posts.tint, icon: ['M8 7l-5 5 5 5', 'M16 7l5 5-5 5', 'M13.5 4.5l-3 15'] },
]
---

<Base title="연보라" showHome={false}>
  <h1 class="sr-only">연보라</h1>
  <nav class="hub" aria-label="섹션">
    {
      Rows.map((Row, r) => (
        <div class="row" data-row={r}>
          {Row.map((s, c) => (
            <a
              class="cell"
              href={s.href}
              aria-label={s.label}
              data-astro-prefetch="viewport"
              data-row={r}
              data-col={c}
              style={`--fill: ${s.fill}; --tint: ${s.tint}`}
              data-section={s.id}
            >
              <span class="mark">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="0.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {s.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
              <span class="en" aria-hidden="true">
                {s.en}
              </span>
              </span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>
  <a
    class="edge edge-bottom"
    href={Profile.href}
    aria-label={Profile.label}
    data-astro-prefetch="hover"
    style={`--fill: ${Profile.fill}`}
  >
    <span class="edge-band" aria-hidden="true"></span>
  </a>
  <button class="edge edge-left" type="button" aria-label="블로그" aria-expanded="false" aria-controls="blog-panel" style="--fill: #3a2a1c">
    <span class="edge-band" aria-hidden="true"></span>
  </button>
  <nav class="blog-panel" id="blog-panel" aria-label="블로그" inert>
    {
      Blogs.map((b) => (
        <a class="half" href={b.href} aria-label={b.label} data-astro-prefetch="hover" style={`--fill: ${b.fill}; --tint: ${b.tint}`}>
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {b.icon.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span class="en" aria-hidden="true">
              {b.en}
            </span>
          </span>
        </a>
      ))
    }
    <span class="panel-edge" aria-hidden="true"></span>
  </nav>
</Base>

<script>
  // 칸을 누르면 그 자리에서 칸 색이 화면 전체로 번지는 애니메이션을 먼저 재생하고, 그 사이 다음 방을 받아 둔다
  // 방 페이지를 받아 오는 시간이 애니메이션 뒤에 숨어 클릭 직후 멈칫하는 느낌이 없다 (번지는 색 = 방이 처음 여는 색이라 이어서 바뀌어도 티가 안 난다)
  // 전환 동안 호버 애니메이션 (칸이 넓어지는 flex-grow, 레이아웃을 매 프레임 다시 계산) 은 끈다
  import { navigate } from 'astro:transitions/client'
  import { prefetch } from 'astro:prefetch'

  const Reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const Duration = 550

  const bind = () => {
    const Hub = document.querySelector<HTMLElement>('.hub')
    if (!Hub || Hub.dataset.bound) return
    Hub.dataset.bound = 'true'
    Hub.classList.remove('leaving')
    document.querySelector('.hub-wipe')?.remove()
    Hub.addEventListener('click', (e) => {
      const Cell = (e.target as HTMLElement).closest<HTMLAnchorElement>('.cell')
      // 새 탭 · 보조키 클릭은 브라우저에 맡긴다
      if (!Cell || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      e.preventDefault()
      if (Hub.classList.contains('leaving')) return
      Hub.classList.add('leaving')
      const Href = Cell.href
      prefetch(Href, { eagerness: 'immediate' })
      if (Reduced()) {
        navigate(Href)
        return
      }
      const R = Cell.getBoundingClientRect()
      const Wipe = document.createElement('div')
      Wipe.className = 'hub-wipe'
      Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Cell.style.getPropertyValue('--fill')}`
      document.body.appendChild(Wipe)
      const From = `inset(${R.top}px ${innerWidth - R.right}px ${innerHeight - R.bottom}px ${R.left}px)`
      Wipe.animate({ clipPath: [From, 'inset(0px)'] }, { duration: Duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
    })
    bindEdges(Hub)
    bindBlogs(Hub)
  }

  // 가장자리 입구 : 마우스가 가장자리에 머물면 (또는 누르면) 그 쪽에서 방 색이 차올라 화면을 채운 뒤 넘어간다
  // 터치는 가장자리 근처에서 화면 안쪽으로 쓸면 들어간다
  const Hold = 450
  const EdgeDuration = 700
  const enterEdge = (Hub: HTMLElement, Edge: HTMLAnchorElement) => {
    if (Hub.classList.contains('leaving')) return
    Hub.classList.add('leaving')
    Edge.classList.add('leaving')
    const Href = Edge.href
    prefetch(Href, { eagerness: 'immediate' })
    if (Reduced()) {
      navigate(Href)
      return
    }
    const Wipe = document.createElement('div')
    Wipe.className = 'hub-wipe'
    Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Edge.style.getPropertyValue('--fill')}`
    document.body.appendChild(Wipe)
    Wipe.animate({ clipPath: ['inset(100% 0 0 0)', 'inset(0 0 0 0)'] }, { duration: EdgeDuration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
  }
  const bindEdges = (Hub: HTMLElement) => {
    const Bottom = document.querySelector<HTMLAnchorElement>('.edge-bottom')
    if (!Bottom) return
    Bottom.classList.remove('leaving')
    let Timer = 0
    Bottom.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') Timer = window.setTimeout(() => enterEdge(Hub, Bottom), Hold)
    })
    Bottom.addEventListener('pointerleave', () => clearTimeout(Timer))
    Bottom.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return
      e.preventDefault()
      clearTimeout(Timer)
      enterEdge(Hub, Bottom)
    })
    let TouchY: number | null = null
    Hub.addEventListener('touchstart', (e) => {
      const Y = e.touches[0].clientY
      TouchY = Y > window.innerHeight - 90 ? Y : null
    }, { passive: true })
    Hub.addEventListener('touchend', (e) => {
      if (TouchY !== null && TouchY - e.changedTouches[0].clientY > 40) enterEdge(Hub, Bottom)
      TouchY = null
    }, { passive: true })
  }
  // 왼쪽 입구 : 마우스가 왼쪽 가장자리에 머물면 (또는 누르면) 블로그 화면이 왼쪽에서 밀려와 화면을 채운다
  // 블로그 화면은 위 (인문) · 아래 (기술) 로 나뉘고, 고른 쪽 색이 번진 뒤 넘어간다
  // 닫기 : 오른쪽 가장자리에 머물기 · Esc · 왼쪽으로 쓸기
  const bindBlogs = (Hub: HTMLElement) => {
    const Left = document.querySelector<HTMLButtonElement>('.edge-left')
    const Panel = document.querySelector<HTMLElement>('.blog-panel')
    if (!Left || !Panel || Panel.dataset.bound) return
    Panel.dataset.bound = 'true'
    // 문서에 붙이는 듣기는 다음 페이지로 넘어갈 때 떼어 낸다
    const Off = new AbortController()
    document.addEventListener('astro:before-swap', () => Off.abort(), { once: true })
    const isOpen = () => Panel.classList.contains('open')
    const open = () => {
      if (isOpen() || Hub.classList.contains('leaving')) return
      Panel.classList.add('open')
      Panel.inert = false
      Left.setAttribute('aria-expanded', 'true')
    }
    const close = () => {
      if (!isOpen() || Panel.classList.contains('leaving')) return
      Panel.classList.remove('open')
      Panel.inert = true
      Left.setAttribute('aria-expanded', 'false')
      Left.focus({ preventScroll: true })
    }
    let Timer = 0
    Left.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') Timer = window.setTimeout(open, Hold)
    })
    Left.addEventListener('pointerleave', () => clearTimeout(Timer))
    Left.addEventListener('click', () => {
      clearTimeout(Timer)
      open()
    })
    const Back = Panel.querySelector<HTMLElement>('.panel-edge')!
    let BackTimer = 0
    Back.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') BackTimer = window.setTimeout(close, Hold)
    })
    Back.addEventListener('pointerleave', () => clearTimeout(BackTimer))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    }, { signal: Off.signal })
    // 반쪽을 누르면 그 반쪽 색이 화면 전체로 번진 뒤 넘어간다 (허브 칸과 같은 연출)
    Panel.addEventListener('click', (e) => {
      const Half = (e.target as HTMLElement).closest<HTMLAnchorElement>('.half')
      if (!Half || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      e.preventDefault()
      if (Panel.classList.contains('leaving')) return
      Panel.classList.add('leaving')
      Hub.classList.add('leaving')
      const Href = Half.href
      prefetch(Href, { eagerness: 'immediate' })
      if (Reduced()) {
        navigate(Href)
        return
      }
      const R = Half.getBoundingClientRect()
      const Wipe = document.createElement('div')
      Wipe.className = 'hub-wipe'
      Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Half.style.getPropertyValue('--fill')}`
      document.body.appendChild(Wipe)
      const From = `inset(${R.top}px ${innerWidth - R.right}px ${innerHeight - R.bottom}px ${R.left}px)`
      Wipe.animate({ clipPath: [From, 'inset(0px)'] }, { duration: Duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
    })
    // 터치 : 왼쪽 가장자리에서 오른쪽으로 쓸면 열고, 열린 화면에서 왼쪽으로 쓸면 닫는다
    let TouchX: number | null = null
    document.addEventListener('touchstart', (e) => {
      const X = e.touches[0].clientX
      TouchX = isOpen() || X < 30 ? X : null
    }, { passive: true, signal: Off.signal })
    document.addEventListener('touchend', (e) => {
      if (TouchX === null) return
      const D = e.changedTouches[0].clientX - TouchX
      if (!isOpen() && D > 40) open()
      else if (isOpen() && D < -60) close()
      TouchX = null
    }, { passive: true, signal: Off.signal })
  }

  document.addEventListener('astro:page-load', bind)
  bind()
</script>

<style>
  /* 전환이 시작되면 호버 애니메이션을 멈춘다 */
  .hub.leaving,
  .hub.leaving * {
    transition: none !important;
    pointer-events: none;
  }
  .hub {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hub-line);
  }
  .row {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    gap: 1px;
    transition: flex-grow var(--hub-speed) var(--hub-ease);
  }
  .cell {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    place-items: center;
    background: var(--hub-bg);
    color: var(--tint);
    outline: none;
    transition:
      flex-grow var(--hub-speed) var(--hub-ease),
      background var(--hub-speed) var(--hub-ease),
      color var(--hub-speed) var(--hub-ease);
  }
  /* 호버 · 포커스한 칸의 행과 열을 넓힌다 (호버가 되는 기기에서만) */
  @media (hover: hover) {
    .hub:has(.cell[data-row='0']:is(:hover, :focus-visible)) .row[data-row='0'],
    .hub:has(.cell[data-row='1']:is(:hover, :focus-visible)) .row[data-row='1'],
    .hub:has(.cell[data-col='0']:is(:hover, :focus-visible)) .cell[data-col='0'],
    .hub:has(.cell[data-col='1']:is(:hover, :focus-visible)) .cell[data-col='1'],
    .hub:has(.cell[data-col='2']:is(:hover, :focus-visible)) .cell[data-col='2'] {
      flex-grow: var(--hub-grow);
    }
  }
  .cell:is(:hover, :focus-visible) {
    background: var(--fill);
    color: var(--hub-icon-active);
  }
  .cell svg {
    width: clamp(88px, 18vmin, 176px);
    height: auto;
    transition: transform var(--hub-speed) var(--hub-ease);
  }
  .cell:is(:hover, :focus-visible) svg {
    transform: scale(1.12);
  }
  /* 아이콘을 칸 정중앙에 두고, 영어 이름은 그 아래에 겹쳐 띄워 아이콘이 밀리지 않게 한다 */
  .mark {
    position: relative;
    display: grid;
    place-items: center;
  }
  .en {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: clamp(12px, 2.4vmin, 24px);
    font-family: var(--hub-label-font);
    font-size: clamp(18px, 2.8vmin, 26px);
    font-weight: 400;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--hub-icon-active);
    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity var(--hub-speed) var(--hub-ease),
      transform var(--hub-speed) var(--hub-ease);
  }
  .cell:is(:hover, :focus-visible) .en {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* 좁은 화면에서는 행 묶음을 풀고 2 x 3 격자로 다시 배치한다 */
  @media (max-width: 640px) {
    .hub {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
    }
    .row {
      display: contents;
    }
  }
  /* 호버가 없는 기기 (휴대폰) 에서는 이름을 항상 보여 준다 */
  @media (hover: none) {
    /* 터치 기기는 누른 뒤 돌아와도 :hover 가 남으므로 칸 색은 누르는 동안에만 바꾼다 */
    .cell:not(:active, :focus-visible) {
      background: var(--hub-bg);
    }
    .cell:not(:active, :focus-visible) svg {
      transform: none;
    }
    .en {
      opacity: 1;
      color: var(--tint);
      transform: translate(-50%, 0);
    }
    .cell:is(:hover, :active, :focus-visible) .en {
      color: var(--hub-icon-active);
    }
  }
  /* 아래 가장자리 입구 : 투명한 띠 위에 마우스가 닿으면 방 색 띠가 살짝 차오른다 */
  .edge {
    position: fixed;
    z-index: 50;
    outline: none;
  }
  .edge-bottom {
    left: 0;
    right: 0;
    bottom: 0;
    height: 64px;
  }
  .edge-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background: var(--fill);
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .edge-bottom:is(:hover, :focus-visible) .edge-band {
    height: 14px;
  }
  /* 왼쪽 가장자리 입구 : 아래 입구와 같은 띠가 왼쪽에서 살짝 차오른다 */
  .edge-left {
    left: 0;
    top: 0;
    bottom: 0;
    width: 64px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .edge-left .edge-band {
    top: 0;
    bottom: 0;
    left: 0;
    right: auto;
    width: 0;
    height: auto;
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .edge-left:is(:hover, :focus-visible) .edge-band {
    width: 14px;
  }
  /* 블로그 화면 : 왼쪽에서 밀려와 화면을 채우고, 위 (인문) · 아래 (기술) 로 나뉜다. 나누는 선과 넓어지는 방식은 허브 칸과 같다 */
  .blog-panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hub-line);
    clip-path: inset(0 100% 0 0);
    visibility: hidden;
    transition:
      clip-path 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.7s;
  }
  .blog-panel.open {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s;
  }
  .blog-panel.leaving,
  .blog-panel.leaving * {
    transition: none !important;
    pointer-events: none;
  }
  .half {
    flex: 1 1 0;
    min-height: 0;
    display: grid;
    place-items: center;
    background: var(--hub-bg);
    color: var(--tint);
    outline: none;
    transition:
      flex-grow var(--hub-speed) var(--hub-ease),
      background var(--hub-speed) var(--hub-ease),
      color var(--hub-speed) var(--hub-ease);
  }
  .half:is(:hover, :focus-visible) {
    background: var(--fill);
    color: var(--hub-icon-active);
  }
  @media (hover: hover) {
    .half:is(:hover, :focus-visible) {
      flex-grow: var(--hub-grow);
    }
  }
  .half svg {
    width: clamp(88px, 18vmin, 176px);
    height: auto;
    transition: transform var(--hub-speed) var(--hub-ease);
  }
  .half:is(:hover, :focus-visible) svg {
    transform: scale(1.12);
  }
  .half:is(:hover, :focus-visible) .en {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* 오른쪽 가장자리에 머물면 블로그 화면이 다시 왼쪽으로 물러난다 */
  .panel-edge {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 48px;
  }
  @media (hover: none) {
    .half:not(:active, :focus-visible) {
      background: var(--hub-bg);
    }
    .half:not(:active, :focus-visible) svg {
      transform: none;
    }
    .half:is(:hover, :active, :focus-visible) .en {
      color: var(--hub-icon-active);
    }
  }
  /* 터치 기기에서는 띠를 보이지 않고 쓸어 올리기만 받는다 */
  @media (hover: none) {
    .edge {
      pointer-events: none;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .row,
    .cell,
    .cell svg,
    .en,
    .edge-band,
    .half,
    .half svg {
      transition: none;
    }
    .blog-panel,
    .blog-panel.open {
      transition-duration: 0.15s;
    }
  }
</style>

---
// 허브 : 화면을 6칸 (데스크톱 3 x 2, 모바일 2 x 3) 으로 나누고 섹션 아이콘만 둔다
// 호버한 칸은 그 섹션의 색으로 칠해지고 같은 행 · 열이 함께 부드럽게 넓어진다
// grid 트랙 보간은 브라우저마다 지원이 달라 flex-grow 전환으로 구현한다
import Base from '@/shared/Base.astro'
import { HubSections, findSection } from '@/sections/registry'
import './tokens.css'

const Rows = [HubSections.slice(0, 3), HubSections.slice(3, 6)]
// 가장자리 입구 : 아래는 프로필, 왼쪽은 블로그 (위 인문 · 아래 기술로 나뉜 화면이 가득 찬다), 오른쪽은 위키
const Profile = findSection('profile')
const Wiki = findSection('wiki')
const Humanities = findSection('humanities')
// 기술 블로그 : 따로 섹션이 생기기 전까지는 서재 (모든 글 목록) 로 보낸다
const Posts = findSection('posts')
const Blogs = [
  { id: Humanities.id, label: Humanities.label, en: Humanities.en, href: Humanities.href, fill: '#3a2a1c', tint: '#e3c27a', icon: Humanities.icon },
  { id: 'tech', label: '기술 블로그', en: 'Tech', href: Posts.href, fill: Posts.fill, tint: Posts.tint, icon: ['M8 7l-5 5 5 5', 'M16 7l5 5-5 5', 'M13.5 4.5l-3 15'] },
]
---

<Base title="연보라" showHome={false}>
  <h1 class="sr-only">연보라</h1>
  <nav class="hub" aria-label="섹션">
    {
      Rows.map((Row, r) => (
        <div class="row" data-row={r}>
          {Row.map((s, c) => (
            <a
              class="cell"
              href={s.href}
              aria-label={s.label}
              data-astro-prefetch="viewport"
              data-row={r}
              data-col={c}
              style={`--fill: ${s.fill}; --tint: ${s.tint}`}
              data-section={s.id}
            >
              <span class="mark">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="0.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {s.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
              <span class="en" aria-hidden="true">
                {s.en}
              </span>
              </span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>
  <a
    class="edge edge-bottom"
    href={Profile.href}
    aria-label={Profile.label}
    data-astro-prefetch="hover"
    style={`--fill: ${Profile.fill}`}
  >
    <span class="edge-band" aria-hidden="true"></span>
  </a>
  <a
    class="edge edge-right"
    href={Wiki.href}
    aria-label={Wiki.label}
    data-astro-prefetch="hover"
    data-from="right"
    style={`--fill: ${Wiki.fill}`}
  >
    <span class="edge-band" aria-hidden="true"></span>
  </a>
  <button class="edge edge-left" type="button" aria-label="블로그" aria-expanded="false" aria-controls="blog-panel" style="--fill: #3a2a1c">
    <span class="edge-band" aria-hidden="true"></span>
  </button>
  <button class="edge edge-top" type="button" aria-label="검색" aria-expanded="false" aria-controls="search-panel" style="--fill: #2c2b42">
    <span class="edge-band" aria-hidden="true"></span>
  </button>
  <div class="search" id="search-panel" inert>
    <div class="search-dim" aria-hidden="true"></div>
    <div class="search-bar" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
      <input class="search-q" type="search" aria-label="블로그 · 위키 검색" autocomplete="off" spellcheck="false" enterkeyhint="go" />
      <kbd aria-hidden="true">Esc</kbd>
    </div>
    <div class="search-res">
      {
        [
          { kind: 'blog', label: '블로그 글', tint: '#e3c27a', icon: Humanities.icon },
          { kind: 'wiki', label: '위키 글', tint: Wiki.tint, icon: Wiki.icon },
        ].map((h) => (
          <section class={`search-half ${h.kind}`} aria-label={h.label} style={`--tint: ${h.tint}`}>
            <div class="search-head">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {h.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
              <span class="search-count" aria-live="polite" />
            </div>
            <ul class="search-list" data-kind={h.kind} />
          </section>
        ))
      }
    </div>
    <span class="search-edge" aria-hidden="true"></span>
  </div>
  <nav class="blog-panel" id="blog-panel" aria-label="블로그" inert>
    {
      Blogs.map((b) => (
        <a class="half" href={b.href} aria-label={b.label} data-astro-prefetch="hover" style={`--fill: ${b.fill}; --tint: ${b.tint}`}>
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {b.icon.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span class="en" aria-hidden="true">
              {b.en}
            </span>
          </span>
        </a>
      ))
    }
    <span class="panel-edge" aria-hidden="true"></span>
  </nav>
</Base>

<script>
  // 칸을 누르면 그 자리에서 칸 색이 화면 전체로 번지는 애니메이션을 먼저 재생하고, 그 사이 다음 방을 받아 둔다
  // 방 페이지를 받아 오는 시간이 애니메이션 뒤에 숨어 클릭 직후 멈칫하는 느낌이 없다 (번지는 색 = 방이 처음 여는 색이라 이어서 바뀌어도 티가 안 난다)
  // 전환 동안 호버 애니메이션 (칸이 넓어지는 flex-grow, 레이아웃을 매 프레임 다시 계산) 은 끈다
  import { navigate } from 'astro:transitions/client'
  import { prefetch } from 'astro:prefetch'
  import { searchItems, type SearchItem } from '@/lib/search/search'

  const Reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const Duration = 550

  const bind = () => {
    const Hub = document.querySelector<HTMLElement>('.hub')
    if (!Hub || Hub.dataset.bound) return
    Hub.dataset.bound = 'true'
    Hub.classList.remove('leaving')
    document.querySelector('.hub-wipe')?.remove()
    Hub.addEventListener('click', (e) => {
      const Cell = (e.target as HTMLElement).closest<HTMLAnchorElement>('.cell')
      // 새 탭 · 보조키 클릭은 브라우저에 맡긴다
      if (!Cell || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      e.preventDefault()
      if (Hub.classList.contains('leaving')) return
      Hub.classList.add('leaving')
      const Href = Cell.href
      prefetch(Href, { eagerness: 'immediate' })
      if (Reduced()) {
        navigate(Href)
        return
      }
      const R = Cell.getBoundingClientRect()
      const Wipe = document.createElement('div')
      Wipe.className = 'hub-wipe'
      Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Cell.style.getPropertyValue('--fill')}`
      document.body.appendChild(Wipe)
      const From = `inset(${R.top}px ${innerWidth - R.right}px ${innerHeight - R.bottom}px ${R.left}px)`
      Wipe.animate({ clipPath: [From, 'inset(0px)'] }, { duration: Duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
    })
    bindEdges(Hub)
    bindBlogs(Hub)
    bindSearch(Hub)
    hintEdges()
  }

  // 처음 들어왔을 때 : 네 가장자리 띠가 차례로 차올랐다가 물러나 입구가 있다는 걸 알려 준다
  // 탭마다 한 번만 (방에 갔다 허브로 돌아올 때는 다시 보여 주지 않는다)
  const hintEdges = () => {
    try {
      if (sessionStorage.getItem('hub-hint')) return
      sessionStorage.setItem('hub-hint', '1')
    } catch {
      return
    }
    const Fast = Reduced()
    const Order: [string, 'width' | 'height', number][] = [
      ['top', 'height', 62],
      ['right', 'width', 70],
      ['bottom', 'height', 70],
      ['left', 'width', 70],
    ]
    Order.forEach(([Side, Prop, Size], i) => {
      const Band = document.querySelector<HTMLElement>(`.edge-${Side} .edge-band`)
      Band?.animate(
        { [Prop]: ['0px', `${Size}px`, `${Size}px`, '0px'], offset: [0, 0.35, 0.6, 1] },
        { duration: Fast ? 500 : 1500, delay: Fast ? 0 : 350 + i * 200, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      )
    })
  }

  // 가장자리 입구 : 마우스가 가장자리에 머물면 (또는 누르면) 그 쪽에서 방 색이 차올라 화면을 채운 뒤 넘어간다
  // 터치는 가장자리 근처에서 화면 안쪽으로 쓸면 들어간다
  const Hold = 450
  const EdgeDuration = 700
  const enterEdge = (Hub: HTMLElement, Edge: HTMLAnchorElement) => {
    if (Hub.classList.contains('leaving')) return
    Hub.classList.add('leaving')
    Edge.classList.add('leaving')
    const Href = Edge.href
    prefetch(Href, { eagerness: 'immediate' })
    if (Reduced()) {
      navigate(Href)
      return
    }
    const Wipe = document.createElement('div')
    Wipe.className = 'hub-wipe'
    Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Edge.style.getPropertyValue('--fill')}`
    document.body.appendChild(Wipe)
    const From = Edge.dataset.from === 'right' ? 'inset(0 0 0 100%)' : 'inset(100% 0 0 0)'
    Wipe.animate({ clipPath: [From, 'inset(0 0 0 0)'] }, { duration: EdgeDuration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
  }
  const bindEdges = (Hub: HTMLElement) => {
    const Bottom = document.querySelector<HTMLAnchorElement>('.edge-bottom')
    const Right = document.querySelector<HTMLAnchorElement>('.edge-right')
    if (!Bottom || !Right) return
    for (const Edge of [Bottom, Right]) {
      Edge.classList.remove('leaving')
      let Timer = 0
      Edge.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') Timer = window.setTimeout(() => enterEdge(Hub, Edge), Hold)
      })
      Edge.addEventListener('pointerleave', () => clearTimeout(Timer))
      Edge.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return
        e.preventDefault()
        clearTimeout(Timer)
        enterEdge(Hub, Edge)
      })
    }
    let TouchY: number | null = null
    Hub.addEventListener('touchstart', (e) => {
      const Y = e.touches[0].clientY
      TouchY = Y > window.innerHeight - 90 ? Y : null
    }, { passive: true })
    Hub.addEventListener('touchend', (e) => {
      if (TouchY !== null && TouchY - e.changedTouches[0].clientY > 40) enterEdge(Hub, Bottom)
      TouchY = null
    }, { passive: true })
    // 터치 : 오른쪽 가장자리에서 왼쪽으로 쓸면 위키로
    let TouchX: number | null = null
    Hub.addEventListener('touchstart', (e) => {
      const X = e.touches[0].clientX
      TouchX = X > window.innerWidth - 30 ? X : null
    }, { passive: true })
    Hub.addEventListener('touchend', (e) => {
      if (TouchX !== null && TouchX - e.changedTouches[0].clientX > 40) enterEdge(Hub, Right)
      TouchX = null
    }, { passive: true })
  }
  // 왼쪽 입구 : 마우스가 왼쪽 가장자리에 머물면 (또는 누르면) 블로그 화면이 왼쪽에서 밀려와 화면을 채운다
  // 블로그 화면은 위 (인문) · 아래 (기술) 로 나뉘고, 고른 쪽 색이 번진 뒤 넘어간다
  // 닫기 : 오른쪽 가장자리에 머물기 · Esc · 왼쪽으로 쓸기
  const bindBlogs = (Hub: HTMLElement) => {
    const Left = document.querySelector<HTMLButtonElement>('.edge-left')
    const Panel = document.querySelector<HTMLElement>('.blog-panel')
    if (!Left || !Panel || Panel.dataset.bound) return
    Panel.dataset.bound = 'true'
    // 문서에 붙이는 듣기는 다음 페이지로 넘어갈 때 떼어 낸다
    const Off = new AbortController()
    document.addEventListener('astro:before-swap', () => Off.abort(), { once: true })
    const isOpen = () => Panel.classList.contains('open')
    const open = () => {
      if (isOpen() || Hub.classList.contains('leaving')) return
      Panel.classList.add('open')
      Panel.inert = false
      Left.setAttribute('aria-expanded', 'true')
    }
    const close = () => {
      if (!isOpen() || Panel.classList.contains('leaving')) return
      Panel.classList.remove('open')
      Panel.inert = true
      Left.setAttribute('aria-expanded', 'false')
      Left.focus({ preventScroll: true })
    }
    let Timer = 0
    Left.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') Timer = window.setTimeout(open, Hold)
    })
    Left.addEventListener('pointerleave', () => clearTimeout(Timer))
    Left.addEventListener('click', () => {
      clearTimeout(Timer)
      open()
    })
    const Back = Panel.querySelector<HTMLElement>('.panel-edge')!
    let BackTimer = 0
    Back.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') BackTimer = window.setTimeout(close, Hold)
    })
    Back.addEventListener('pointerleave', () => clearTimeout(BackTimer))
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    }, { signal: Off.signal })
    // 반쪽을 누르면 그 반쪽 색이 화면 전체로 번진 뒤 넘어간다 (허브 칸과 같은 연출)
    Panel.addEventListener('click', (e) => {
      const Half = (e.target as HTMLElement).closest<HTMLAnchorElement>('.half')
      if (!Half || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      e.preventDefault()
      if (Panel.classList.contains('leaving')) return
      Panel.classList.add('leaving')
      Hub.classList.add('leaving')
      const Href = Half.href
      prefetch(Href, { eagerness: 'immediate' })
      if (Reduced()) {
        navigate(Href)
        return
      }
      const R = Half.getBoundingClientRect()
      const Wipe = document.createElement('div')
      Wipe.className = 'hub-wipe'
      Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Half.style.getPropertyValue('--fill')}`
      document.body.appendChild(Wipe)
      const From = `inset(${R.top}px ${innerWidth - R.right}px ${innerHeight - R.bottom}px ${R.left}px)`
      Wipe.animate({ clipPath: [From, 'inset(0px)'] }, { duration: Duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
    })
    // 터치 : 왼쪽 가장자리에서 오른쪽으로 쓸면 열고, 열린 화면에서 왼쪽으로 쓸면 닫는다
    let TouchX: number | null = null
    document.addEventListener('touchstart', (e) => {
      const X = e.touches[0].clientX
      TouchX = isOpen() || X < 30 ? X : null
    }, { passive: true, signal: Off.signal })
    document.addEventListener('touchend', (e) => {
      if (TouchX === null) return
      const D = e.changedTouches[0].clientX - TouchX
      if (!isOpen() && D > 40) open()
      else if (isOpen() && D < -60) close()
      TouchX = null
    }, { passive: true, signal: Off.signal })
  }

  // 위쪽 입구 : 마우스가 위쪽 가장자리에 머물면 (또는 / · Ctrl+K) 검색창이 내려온다
  // 입력하면 블로그 결과는 왼쪽에서, 위키 결과는 오른쪽에서 밀려온다 (허브 왼쪽 · 오른쪽 입구와 같은 방향)
  let Index: Promise<SearchItem[]> | undefined
  const loadIndex = () =>
    (Index ??= fetch('/search-index.json')
      .then((r) => r.json() as Promise<SearchItem[]>)
      .catch(() => {
        Index = undefined
        return []
      }))
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)
  // 낱말마다 첫 번째 자리를 형광펜으로
  const mark = (s: string, Words: string[]) => {
    const Spans: [number, number][] = []
    const L = s.toLowerCase()
    for (const w of Words) {
      const i = L.indexOf(w)
      if (i >= 0) Spans.push([i, i + w.length])
    }
    Spans.sort((a, b) => a[0] - b[0])
    let Out = ''
    let At = 0
    for (const [a, b] of Spans) {
      if (a < At) continue
      Out += esc(s.slice(At, a)) + '<mark>' + esc(s.slice(a, b)) + '</mark>'
      At = b
    }
    return Out + esc(s.slice(At))
  }
  // 미리보기 : 본문에 낱말이 있으면 그 근처부터 보여 준다
  const snippet = (text: string, Words: string[]) => {
    const i = Math.min(...Words.map((w) => text.toLowerCase().indexOf(w)).filter((x) => x >= 0))
    if (!Number.isFinite(i) || i <= 40) return text
    // 낱말 중간에서 자르지 않게 앞쪽 띄어쓰기에서 시작한다
    const From = text.lastIndexOf(' ', i - 12)
    return `…${text.slice(From > 0 ? From + 1 : i)}`
  }
  const EmptyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5M8.5 11h5"/></svg>'

  const bindSearch = (Hub: HTMLElement) => {
    const Top = document.querySelector<HTMLButtonElement>('.edge-top')
    const Panel = document.querySelector<HTMLElement>('.search')
    if (!Top || !Panel || Panel.dataset.bound) return
    Panel.dataset.bound = 'true'
    const Off = new AbortController()
    document.addEventListener('astro:before-swap', () => Off.abort(), { once: true })
    const Input = Panel.querySelector<HTMLInputElement>('.search-q')!
    const Lists = [...Panel.querySelectorAll<HTMLUListElement>('.search-list')]
    const isOpen = () => Panel.classList.contains('open')
    const open = () => {
      if (isOpen() || Hub.classList.contains('leaving')) return
      document.querySelector('.blog-panel.open') && document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' }))
      loadIndex()
      Panel.classList.add('open')
      Panel.inert = false
      Top.setAttribute('aria-expanded', 'true')
      setTimeout(() => Input.focus({ preventScroll: true }), Reduced() ? 0 : 200)
    }
    const close = () => {
      if (!isOpen()) return
      Panel.classList.remove('open', 'has-q')
      Panel.inert = true
      Top.setAttribute('aria-expanded', 'false')
      Input.value = ''
      Input.blur()
    }
    let Seq = 0
    const render = async () => {
      const Q = Input.value.trim()
      Panel.classList.toggle('has-q', !!Q)
      if (!Q) return
      const Me = ++Seq
      const All = await loadIndex()
      if (Me !== Seq) return
      const Words = Q.toLowerCase().split(/\s+/)
      const Found = searchItems(All, Q)
      for (const List of Lists) {
        const Hits = Found.filter((it) => it.kind === List.dataset.kind)
        List.closest('section')!.querySelector('.search-count')!.textContent = String(Hits.length)
        List.innerHTML = Hits.length
          ? Hits.map((it) => `<li><a class="search-item" href="${esc(it.href)}"><span class="search-title">${mark(it.title, Words)}</span>${it.text ? `<span class="search-text">${mark(snippet(it.text, Words), Words)}</span>` : ''}<span class="search-meta"><span class="search-chip${it.section ? ` ${it.section}` : ''}">${esc(it.label)}</span>${it.date ? esc(it.date) : ''}</span></a></li>`).join('')
          : `<li class="search-empty">${EmptyIcon}</li>`
      }
    }
    Input.addEventListener('input', render)
    Input.addEventListener('keydown', (e) => {
      // Enter : 가장 잘 맞는 결과로, ↓ : 결과 목록으로
      if (e.key === 'Enter') {
        const Best = Panel.querySelector<HTMLAnchorElement>('.search-item')
        if (Best) {
          e.preventDefault()
          navigate(Best.href)
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault()
        Panel.querySelector<HTMLAnchorElement>('.search-item')?.focus()
      }
    })
    // 결과 안에서 ↑ ↓ 로 옮기고, ← → 로 반대쪽 목록으로
    Panel.querySelector('.search-res')!.addEventListener('keydown', (e) => {
      const K = (e as KeyboardEvent).key
      const Cur = document.activeElement as HTMLElement | null
      if (!Cur?.classList.contains('search-item')) return
      const List = [...Cur.closest('ul')!.querySelectorAll<HTMLAnchorElement>('.search-item')]
      const i = List.indexOf(Cur as HTMLAnchorElement)
      let Next: HTMLElement | null | undefined
      if (K === 'ArrowDown') Next = List[i + 1]
      else if (K === 'ArrowUp') Next = i > 0 ? List[i - 1] : Input
      else if (K === 'ArrowLeft' || K === 'ArrowRight') Next = Panel.querySelector<HTMLElement>(`.search-half.${K === 'ArrowLeft' ? 'blog' : 'wiki'} .search-item`)
      if (Next) {
        e.preventDefault()
        Next.focus()
      }
    })
    // 검색어가 없을 때 어두운 바깥을 누르면 닫는다
    Panel.querySelector('.search-dim')!.addEventListener('click', close)
    // 아래쪽 가장자리에 머물면 검색창이 다시 위로 올라간다 (블로그 화면의 오른쪽 가장자리와 같은 방식)
    const Down = Panel.querySelector<HTMLElement>('.search-edge')!
    let DownTimer = 0
    Down.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') DownTimer = window.setTimeout(close, Hold)
    })
    Down.addEventListener('pointerleave', () => clearTimeout(DownTimer))
    let Timer = 0
    Top.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return
      loadIndex()
      Timer = window.setTimeout(open, Hold)
    })
    Top.addEventListener('pointerleave', () => clearTimeout(Timer))
    Top.addEventListener('click', () => {
      clearTimeout(Timer)
      open()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return close()
      const Typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable]')
      if (!Typing && (e.key === '/' || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey)))) {
        e.preventDefault()
        open()
      }
    }, { signal: Off.signal })
    // 터치 : 위쪽 가장자리에서 아래로 쓸면 연다
    let TouchY: number | null = null
    Hub.addEventListener('touchstart', (e) => {
      const Y = e.touches[0].clientY
      TouchY = Y < 30 ? Y : null
    }, { passive: true })
    Hub.addEventListener('touchend', (e) => {
      if (TouchY !== null && e.changedTouches[0].clientY - TouchY > 40) open()
      TouchY = null
    }, { passive: true })
  }

  document.addEventListener('astro:page-load', bind)
  bind()
</script>

<style>

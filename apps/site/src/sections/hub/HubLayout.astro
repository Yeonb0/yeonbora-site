---
// 허브 : 바탕화면 같은 아이콘 격자 (디자인은 목업 승인 전 임시)
import Base from '@/shared/Base.astro'
import { Sections } from '@/sections/registry'
import './tokens.css'
---

<Base title="연보라" showHome={false}>
  <main class="hub">
    <ul class="grid">
      {
        Sections.map((s) => (
          <li>
            <a class="icon" href={s.href}>
              <span class="tile" transition:name={`section-${s.id}`}>
                {s.glyph}
              </span>
              <span class="label">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .hub {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--hub-bg);
    color: var(--hub-fg);
    font-family: system-ui, sans-serif;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 96px);
    gap: 32px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(4, 96px);
    }
  }
  .icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 18px;
    font-size: 32px;
    background: var(--hub-tile);
    transition: background 0.15s;
  }
  .icon:hover .tile,
  .icon:focus-visible .tile {
    background: var(--hub-tile-hover);
  }
  .label {
    font-size: 14px;
  }
</style>

---
// 허브 : 화면을 6칸 (데스크톱 3 x 2, 모바일 2 x 3) 으로 나누고 섹션 아이콘만 둔다
// 호버한 칸은 그 섹션의 색으로 칠해지고 같은 행 · 열이 함께 부드럽게 넓어진다
// grid 트랙 보간은 브라우저마다 지원이 달라 flex-grow 전환으로 구현한다
import Base from '@/shared/Base.astro'
import { HubSections } from '@/sections/registry'
import './tokens.css'

const Rows = [HubSections.slice(0, 3), HubSections.slice(3, 6)]
---

<Base title="연보라" showHome={false}>
  <h1 class="sr-only">연보라</h1>
  <nav class="hub" aria-label="섹션">
    {
      Rows.map((Row, r) => (
        <div class="row" data-row={r}>
          {Row.map((s, c) => (
            <a
              class="cell"
              href={s.href}
              aria-label={s.label}
              data-astro-prefetch="viewport"
              data-row={r}
              data-col={c}
              style={`--fill: ${s.fill}; --tint: ${s.tint}`}
              data-section={s.id}
            >
              <span class="mark">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="0.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {s.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
              <span class="en" aria-hidden="true">
                {s.en}
              </span>
              </span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>
</Base>

<script>
  // 칸을 누르면 그 자리에서 칸 색이 화면 전체로 번지는 애니메이션을 먼저 재생하고, 그 사이 다음 방을 받아 둔다
  // 방 페이지를 받아 오는 시간이 애니메이션 뒤에 숨어 클릭 직후 멈칫하는 느낌이 없다 (번지는 색 = 방이 처음 여는 색이라 이어서 바뀌어도 티가 안 난다)
  // 전환 동안 호버 애니메이션 (칸이 넓어지는 flex-grow, 레이아웃을 매 프레임 다시 계산) 은 끈다
  import { navigate } from 'astro:transitions/client'
  import { prefetch } from 'astro:prefetch'

  const Reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const Duration = 550

  const bind = () => {
    const Hub = document.querySelector<HTMLElement>('.hub')
    if (!Hub || Hub.dataset.bound) return
    Hub.dataset.bound = 'true'
    Hub.classList.remove('leaving')
    document.querySelector('.hub-wipe')?.remove()
    Hub.addEventListener('click', (e) => {
      const Cell = (e.target as HTMLElement).closest<HTMLAnchorElement>('.cell')
      // 새 탭 · 보조키 클릭은 브라우저에 맡긴다
      if (!Cell || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      e.preventDefault()
      if (Hub.classList.contains('leaving')) return
      Hub.classList.add('leaving')
      const Href = Cell.href
      prefetch(Href, { eagerness: 'immediate' })
      if (Reduced()) {
        navigate(Href)
        return
      }
      const R = Cell.getBoundingClientRect()
      const Wipe = document.createElement('div')
      Wipe.className = 'hub-wipe'
      Wipe.style.cssText = `position:fixed;inset:0;z-index:200;pointer-events:none;background:${Cell.style.getPropertyValue('--fill')}`
      document.body.appendChild(Wipe)
      const From = `inset(${R.top}px ${innerWidth - R.right}px ${innerHeight - R.bottom}px ${R.left}px)`
      Wipe.animate({ clipPath: [From, 'inset(0px)'] }, { duration: Duration, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }).finished.then(() => navigate(Href))
    })
  }
  document.addEventListener('astro:page-load', bind)
  bind()
</script>

<style>
  /* 전환이 시작되면 호버 애니메이션을 멈춘다 */
  .hub.leaving,
  .hub.leaving * {
    transition: none !important;
    pointer-events: none;
  }
  .hub {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hub-line);
  }
  .row {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    gap: 1px;
    transition: flex-grow var(--hub-speed) var(--hub-ease);
  }
  .cell {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    place-items: center;
    background: var(--hub-bg);
    color: var(--tint);
    outline: none;
    transition:
      flex-grow var(--hub-speed) var(--hub-ease),
      background var(--hub-speed) var(--hub-ease),
      color var(--hub-speed) var(--hub-ease);
  }
  /* 호버 · 포커스한 칸의 행과 열을 넓힌다 (호버가 되는 기기에서만) */
  @media (hover: hover) {
    .hub:has(.cell[data-row='0']:is(:hover, :focus-visible)) .row[data-row='0'],
    .hub:has(.cell[data-row='1']:is(:hover, :focus-visible)) .row[data-row='1'],
    .hub:has(.cell[data-col='0']:is(:hover, :focus-visible)) .cell[data-col='0'],
    .hub:has(.cell[data-col='1']:is(:hover, :focus-visible)) .cell[data-col='1'],
    .hub:has(.cell[data-col='2']:is(:hover, :focus-visible)) .cell[data-col='2'] {
      flex-grow: var(--hub-grow);
    }
  }
  .cell:is(:hover, :focus-visible) {
    background: var(--fill);
    color: var(--hub-icon-active);
  }
  .cell svg {
    width: clamp(88px, 18vmin, 176px);
    height: auto;
    transition: transform var(--hub-speed) var(--hub-ease);
  }
  .cell:is(:hover, :focus-visible) svg {
    transform: scale(1.12);
  }
  /* 아이콘을 칸 정중앙에 두고, 영어 이름은 그 아래에 겹쳐 띄워 아이콘이 밀리지 않게 한다 */
  .mark {
    position: relative;
    display: grid;
    place-items: center;
  }
  .en {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: clamp(12px, 2.4vmin, 24px);
    font-family: var(--hub-label-font);
    font-size: clamp(18px, 2.8vmin, 26px);
    font-weight: 400;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--hub-icon-active);
    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity var(--hub-speed) var(--hub-ease),
      transform var(--hub-speed) var(--hub-ease);
  }
  .cell:is(:hover, :focus-visible) .en {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* 좁은 화면에서는 행 묶음을 풀고 2 x 3 격자로 다시 배치한다 */
  @media (max-width: 640px) {
    .hub {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
    }
    .row {
      display: contents;
    }
  }
  /* 호버가 없는 기기 (휴대폰) 에서는 이름을 항상 보여 준다 */
  @media (hover: none) {
    /* 터치 기기는 누른 뒤 돌아와도 :hover 가 남으므로 칸 색은 누르는 동안에만 바꾼다 */
    .cell:not(:active, :focus-visible) {
      background: var(--hub-bg);
    }
    .cell:not(:active, :focus-visible) svg {
      transform: none;
    }
    .en {
      opacity: 1;
      color: var(--tint);
      transform: translate(-50%, 0);
    }
    .cell:is(:hover, :active, :focus-visible) .en {
      color: var(--hub-icon-active);
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .row,
    .cell,
    .cell svg,
    .en {
      transition: none;
    }
  }
</style>

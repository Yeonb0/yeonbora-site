---
// 허브 : 화면을 4분할하고 섹션 아이콘만 둔다
// 호버한 칸은 그 섹션의 보라색으로 칠해지고 행 · 열이 함께 넓어진다
import Base from '@/shared/Base.astro'
import { Sections } from '@/sections/registry'
import './tokens.css'
---

<Base title="연보라" showHome={false}>
  <h1 class="sr-only">연보라</h1>
  <nav class="hub" aria-label="섹션">
    {
      Sections.map((s) => (
        <a
          class="cell"
          href={s.href}
          aria-label={s.label}
          style={`--fill: ${s.fill}`}
          transition:name={`section-${s.id}`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {s.icon.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      ))
    }
  </nav>
</Base>

<style>
  .hub {
    height: 100dvh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1px;
    background: var(--hub-line);
    transition:
      grid-template-columns var(--hub-speed) ease,
      grid-template-rows var(--hub-speed) ease;
  }
  /* 호버 · 포커스한 칸이 속한 열과 행을 넓힌다 (1 2 / 3 4 순서) */
  .hub:has(.cell:nth-child(1):is(:hover, :focus-visible)) {
    grid-template-columns: var(--hub-grow) 1fr;
    grid-template-rows: var(--hub-grow) 1fr;
  }
  .hub:has(.cell:nth-child(2):is(:hover, :focus-visible)) {
    grid-template-columns: 1fr var(--hub-grow);
    grid-template-rows: var(--hub-grow) 1fr;
  }
  .hub:has(.cell:nth-child(3):is(:hover, :focus-visible)) {
    grid-template-columns: var(--hub-grow) 1fr;
    grid-template-rows: 1fr var(--hub-grow);
  }
  .hub:has(.cell:nth-child(4):is(:hover, :focus-visible)) {
    grid-template-columns: 1fr var(--hub-grow);
    grid-template-rows: 1fr var(--hub-grow);
  }
  .cell {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    background: var(--hub-bg);
    color: var(--hub-icon);
    outline: none;
    transition:
      background var(--hub-speed) ease,
      color var(--hub-speed) ease;
  }
  .cell svg {
    width: clamp(44px, 6vw, 64px);
    height: auto;
    transition: transform var(--hub-speed) ease;
  }
  .cell:is(:hover, :focus-visible) {
    background: var(--fill);
    color: var(--hub-icon-active);
  }
  .cell:is(:hover, :focus-visible) svg {
    transform: scale(1.3);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .hub,
    .cell,
    .cell svg {
      transition: none;
    }
  }
</style>

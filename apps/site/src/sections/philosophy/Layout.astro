---
// philosophy 섹션 전용 레이아웃 : 허브 아이콘이 이 화면 전체로 확대되며 넘어온다
import Base from '@/shared/Base.astro'
import { findSection } from '@/sections/registry'
import './tokens.css'
import './home.css'

const Me = findSection('philosophy')
---

<Base title={`${Me.label} · 연보라`}>
  <Fragment slot="home">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7" /><path d="M5.5 9.5V20h13V9.5" /><path d="M10 20v-5h4v5" /></svg>
  </Fragment>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 명판 대신 쓰는 이름 글자 : 서양관 영문 Cinzel, 동양관 한자 Noto Serif KR -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=Noto+Serif+KR:wght@700&display=swap" />
  </Fragment>
  <!-- 허브에서 막 들어왔는지 (이 섬의 기록 깊이가 아직 없음) : 글에서 돌아오거나 뒤로가기면 보라색 번짐 없이 -->
  <script is:inline>
    document.documentElement.toggleAttribute('data-enter-hub', history.state?.museumDepth === undefined)
  </script>
  <main class="section-philosophy" transition:name={`section-${Me.id}`}>
    <slot />
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    /* 섬이 뜨기 전 (client:only 라 잠깐 비어 있다) 에도 어두운 바탕이라 허브 칸 색에서 자연스럽게 이어진다 */
    background: #0b0806;
    color: var(--fg);
    font-family: var(--font-base);
  }
  /* 허브 칸 색 (보라) 에서 어두운 바탕으로 : 화면 전환 (0.6s) 과 함께 시작해 이어서 가라앉는다 */
  :global(html[data-enter-hub]) main {
    animation: enter-dusk 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes enter-dusk {
    from {
      background: var(--enter-from);
    }
    to {
      background: #0b0806;
    }
  }
  :global(::view-transition-group(section-philosophy)),
  :global(::view-transition-old(section-philosophy)),
  :global(::view-transition-new(section-philosophy)) {
    animation-duration: 0.6s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

---
// profile 섹션 레이아웃 : 허브 아래 가장자리에서 올라오는 한 장짜리 화면
// 왼쪽에 아스키 행성 (D2Coding), 오른쪽에 자기소개 글
// 돌아갈 때는 이 화면이 아래로 내려가며 허브가 드러난다 (view-transition-name : profile-sheet, 애니메이션은 Base.astro)
import Base from '@/shared/Base.astro'
import { findSection } from '@/sections/registry'
import './tokens.css'

const Me = findSection('profile')
---

<Base title={`${Me.label} · 연보라`} description="연보라 (Yeonb0) 소개">
  <main class="section-profile">
    <div class="back-edge" aria-hidden="true"></div>
    <div class="layout">
      <div class="art" aria-hidden="true"><pre class="planet"></pre></div>
      <div class="doc">
        <slot />
      </div>
    </div>
  </main>
</Base>

<script>
  import { navigate } from 'astro:transitions/client'
  import { drawPlanet, type Light } from './planet'

  const Reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
  // 위 가장자리에 이만큼 머물러야 돌아간다 (지나가는 마우스로는 닫히지 않게)
  const Hold = 450

  const bind = () => {
    const Main = document.querySelector<HTMLElement>('.section-profile')
    if (!Main || Main.dataset.bound) return
    Main.dataset.bound = 'true'
    const Planet = Main.querySelector<HTMLElement>('.planet')!
    const Edge = Main.querySelector<HTMLElement>('.back-edge')!
    const Sun: Light = { x: 0.6, y: -0.5 }
    const Start = performance.now()
    let Frame = 0
    let Leaving = false

    // 허브에서 번진 색이 화면을 다 채운 상태로 넘어오므로 글만 이어서 떠오르게 한다
    requestAnimationFrame(() => Main.classList.add('shown'))

    const draw = (now: number) => {
      const Small = window.innerWidth < 760
      Planet.innerHTML = drawPlanet(Small ? 72 : 104, Small ? 34 : 44, Reduced() ? 0 : (now - Start) / 1000, Sun)
      if (!Reduced()) Frame = requestAnimationFrame(draw)
    }
    Frame = requestAnimationFrame(draw)

    const onMove = (e: PointerEvent) => {
      // 마우스가 있는 쪽에서 빛이 온다
      Sun.x = (e.clientX / window.innerWidth - 0.5) * 2
      Sun.y = (e.clientY / window.innerHeight - 0.5) * 2
      if (Reduced()) requestAnimationFrame(draw)
    }
    window.addEventListener('pointermove', onMove)

    const leave = () => {
      if (Leaving) return
      Leaving = true
      navigate('/')
    }

    // 위 가장자리 : 들어온 뒤 마우스가 한 번 움직여야 동작한다 (들어오는 순간 마우스가 위에 있어도 바로 닫히지 않게)
    let Moved = false
    let Timer = 0
    Main.addEventListener('pointermove', () => (Moved = true), { once: true })
    Edge.addEventListener('pointerenter', () => {
      if (Moved) Timer = window.setTimeout(leave, Hold)
    })
    Edge.addEventListener('pointerleave', () => clearTimeout(Timer))

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') leave()
    }
    window.addEventListener('keydown', onKey)

    // 터치 : 맨 위까지 올린 상태에서 아래로 쓸어 내리면 돌아간다
    let TouchY: number | null = null
    let TouchTop = false
    Main.addEventListener('touchstart', (e) => {
      TouchY = e.touches[0].clientY
      TouchTop = Main.scrollTop <= 0
    }, { passive: true })
    Main.addEventListener('touchend', (e) => {
      if (TouchY !== null && TouchTop && e.changedTouches[0].clientY - TouchY > 80) leave()
      TouchY = null
    }, { passive: true })

    // 다른 페이지로 넘어가면 그리기와 창 이벤트를 정리한다
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(Frame)
      window.removeEventListener('pointermove', onMove)
      window.removeEventListener('keydown', onKey)
    }, { once: true })
  }
  document.addEventListener('astro:page-load', bind)
</script>

<style>
  main {
    position: fixed;
    inset: 0;
    overflow-y: auto;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-base);
    font-size: 16px;
    line-height: 1.7;
    word-break: keep-all;
    scrollbar-width: thin;
    scrollbar-color: rgba(241, 236, 255, 0.25) transparent;
    view-transition-name: profile-sheet;
  }
  .back-edge {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 24px;
    z-index: 10;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    min-height: 100%;
  }
  .art {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .planet {
    margin: 0;
    font-family: 'D2CodingPlanet', monospace;
    font-size: clamp(7px, 1.05vw, 12px);
    line-height: 1;
    color: var(--fg);
    user-select: none;
  }
  .planet :global(.star) {
    color: var(--profile-accent);
  }
  .doc {
    padding: 96px 56px 120px 8px;
    max-width: 620px;
  }
  /* 글은 아래에서 살짝 떠오르며 나타난다 */
  .doc > :global(*) {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s var(--profile-ease),
      transform 0.6s var(--profile-ease);
  }
  .shown .doc > :global(*) {
    opacity: 1;
    transform: none;
  }
  .shown .doc > :global(*:nth-child(2)) {
    transition-delay: 0.06s;
  }
  .shown .doc > :global(*:nth-child(3)) {
    transition-delay: 0.12s;
  }
  .shown .doc > :global(*:nth-child(n + 4)) {
    transition-delay: 0.18s;
  }
  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .art {
      position: relative;
      height: 52vh;
    }
    .planet {
      font-size: 9px;
    }
    .doc {
      padding: 8px 24px 100px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .doc > :global(*) {
      transition: none;
    }
  }
</style>

---
// religion 섹션 전용 레이아웃 : 허브 아이콘이 이 화면 전체로 확대되며 넘어온다
import Base from '@/shared/Base.astro'
import { findSection } from '@/sections/registry'
import './tokens.css'
import './home.css'

const Me = findSection('religion')
---

<Base title={`${Me.label} · 연보라`}>
  <Fragment slot="home">
    <span class="home-pin"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7" /><path d="M5.5 9.5V20h13V9.5" /><path d="M10 20v-5h4v5" /></svg><span class="home-pin-shine"></span></span>
  </Fragment>
  <!-- 허브에서 막 들어왔는지 (이 방의 기록 깊이가 아직 없음) : 글에서 돌아오거나 뒤로가기면 상자를 연 채로 바로 보인다 -->
  <script is:inline>
    document.documentElement.toggleAttribute('data-enter-hub', history.state?.religionDepth === undefined)
  </script>
  <main class="section-religion" transition:name={`section-${Me.id}`}>
    <slot />
  </main>
</Base>

<script>
  // 홈 버튼 핀 : 마우스 x 를 따라 세로 빛줄기를 옮긴다 (문서에 한 번만 걸어 두고 방을 오가도 그대로 쓴다)
  document.addEventListener('pointermove', (e) => {
    const Pin = (e.target as Element | null)?.closest?.<HTMLElement>('.home-pin')
    if (!Pin) return
    const B = Pin.getBoundingClientRect()
    Pin.style.setProperty('--shine-x', `${((e.clientX - B.left) / B.width) * 100}%`)
  })
</script>

<style>
  main {
    min-height: 100dvh;
    /* 섬이 뜨기 전 (client:only 라 잠깐 비어 있다) 에도 어두운 바탕이라 허브 칸 색에서 자연스럽게 이어진다 */
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-base);
  }
  /* 허브 칸 색 (보라) 에서 어두운 방으로 : 화면 전환 (0.6s) 과 함께 시작해 이어서 가라앉는다 */
  :global(html[data-enter-hub]) main {
    animation: enter-dusk 1.1s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes enter-dusk {
    from {
      background: var(--enter-from);
    }
    to {
      background: var(--bg);
    }
  }
  :global(::view-transition-group(section-religion)),
  :global(::view-transition-old(section-religion)),
  :global(::view-transition-new(section-religion)) {
    animation-duration: 0.6s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

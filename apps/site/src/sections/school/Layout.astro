---
// school 섹션 전용 레이아웃 : 허브 아이콘이 이 화면 전체로 확대되며 넘어온다
import Base from '@/shared/Base.astro'
import { findSection } from '@/sections/registry'
import './tokens.css'
import './home.css'

const Me = findSection('school')
---

<Base title={`${Me.label} · 연보라`}>
  <Fragment slot="home">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7" /><path d="M5.5 9.5V20h13V9.5" /><path d="M10 20v-5h4v5" /></svg>
  </Fragment>
  <main class="section-school" transition:name={`section-${Me.id}`}>
    <slot />
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-base);
  }
</style>

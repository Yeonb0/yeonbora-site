---
// wiki 섹션 레이아웃 : 허브 칸이 아니라 글 안의 링크로 들어온다
import Base from '@/shared/Base.astro'
import { findSection } from '@/sections/registry'
import './tokens.css'

interface Props {
  title?: string
}

const Me = findSection('wiki')
const { title } = Astro.props
---

<Base title={`${title ?? Me.label} · 연보라`}>
  <main class="section-wiki" transition:name={`section-${Me.id}`}>
    <slot />
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    padding: 96px 20px 48px;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-base);
  }
</style>

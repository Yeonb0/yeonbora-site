---
// 모든 섹션이 공유하는 최소 골격 : 라우터 + 메타 + 홈 버튼
import { ClientRouter } from 'astro:transitions'
import './fonts.css'

interface Props {
  title: string
  description?: string
  showHome?: boolean
}

const { title, description = '연보라의 실험장', showHome = true } = Astro.props
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://hangeul.pstatic.net" crossorigin />
    <link rel="stylesheet" href="https://hangeul.pstatic.net/hangeul_static/css/nanum-square.css" />
    <link rel="stylesheet" href="https://hangeul.pstatic.net/hangeul_static/css/nanum-square-neo.css" />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    {
      showHome && (
        <a class="home-button" href="/" aria-label="홈으로" transition:persist>
          ⌂
        </a>
      )
    }
    <slot />
    <script>
      // 방 → 허브로 돌아갈 때 : 새 허브 문서에서 그 방의 칸에만 같은 이름을 붙여 줄어드는 전환의 짝이 되게 한다
      document.addEventListener('astro:before-swap', (e) => {
        const Id = [...(document.querySelector('main[class^="section-"]')?.classList ?? [])].find((c) => c.startsWith('section-'))?.slice(8)
        if (!Id) return
        e.newDocument.querySelector<HTMLElement>(`.cell[data-section="${Id}"]`)?.style.setProperty('view-transition-name', `section-${Id}`)
      })
    </script>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
      }
      /* 방 전환 중 화면 뒤로 흰 배경이 비치지 않게 기본 바탕을 어둡게 둔다 */
      html {
        background: var(--bg, #1a1a1a);
      }
      body {
        font-family: var(--font-base);
      }
      .home-button {
        position: fixed;
        top: 16px;
        left: 16px;
        z-index: 100;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        font-size: 22px;
        text-decoration: none;
        color: var(--home-fg, #e0e0e0);
        /* 흐림 효과 (backdrop-filter) 는 모든 화면 위에서 매 프레임 뒤 화면을 다시 흐려 느려진다 : 반투명 배경으로 대신한다 */
        background: var(--home-bg, rgba(255, 255, 255, 0.1));
      }
      /* 바뀌는 페이지 전체 (root) 를 크로스페이드하지 않는다 : 전체 화면 합성이 한 겹 줄어 덜 끊긴다. 이름 붙은 방 (section-*) 만 움직인다 */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      /* 프로필 → 다른 화면 : 프로필이 위에서부터 걷히며 아래로 내려가고, 그 밑에 새 화면이 드러난다 */
      /* view transition 의사 요소는 바뀐 뒤 문서의 CSS 로 그려져 프로필 레이아웃이 아니라 공유 골격에 둔다 */
      /* 들어올 때는 허브에서 번진 색이 이미 화면을 채우고 있어 따로 움직이지 않는다 */
      ::view-transition-new(profile-sheet) {
        animation: none;
      }
      ::view-transition-old(profile-sheet) {
        animation: profile-sheet-down 0.7s cubic-bezier(0.4, 0, 0.2, 1) both;
      }
      ::view-transition-group(profile-sheet) {
        animation-duration: 0.7s;
      }
      @keyframes profile-sheet-down {
        from {
          clip-path: inset(0 0 0 0);
        }
        to {
          clip-path: inset(100% 0 0 0);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }
    </style>
  </body>
</html>

---
// 모든 섹션이 공유하는 최소 골격 : 라우터 + 메타 + 홈 버튼
import { ClientRouter } from 'astro:transitions'
import './fonts.css'

interface Props {
  title: string
  description?: string
  showHome?: boolean
}

const { title, description = '연보라의 실험장', showHome = true } = Astro.props
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://hangeul.pstatic.net" crossorigin />
    <link rel="stylesheet" href="https://hangeul.pstatic.net/hangeul_static/css/nanum-square.css" />
    <link rel="stylesheet" href="https://hangeul.pstatic.net/hangeul_static/css/nanum-square-neo.css" />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    {
      showHome && (
        <a class="home-button" href="/" aria-label="홈으로">
          {/* 방마다 홈 버튼 겉모양이 다르다 : 방 Layout 이 slot="home" 으로 안쪽을 넣고, 모양은 그 방의 home.css 가 입힌다 */}
          <slot name="home">⌂</slot>
        </a>
      )
    }
    <slot />
    <script>
      // 방 → 허브로 돌아갈 때 : 새 허브 문서에서 그 방의 칸에만 같은 이름을 붙여 줄어드는 전환의 짝이 되게 한다
      document.addEventListener('astro:before-swap', (e) => {
        const Id = [...(document.querySelector('main[class^="section-"]')?.classList ?? [])].find((c) => c.startsWith('section-'))?.slice(8)
        if (!Id) return
        e.newDocument.querySelector<HTMLElement>(`.cell[data-section="${Id}"]`)?.style.setProperty('view-transition-name', `section-${Id}`)
      })
    </script>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
      }
      /* 방 전환 중 화면 뒤로 흰 배경이 비치지 않게 기본 바탕을 어둡게 둔다 */
      html {
        background: var(--bg, #1a1a1a);
      }
      body {
        font-family: var(--font-base);
      }
      /* 홈 버튼 기본 모양 (컴퓨터 방이 그대로 쓴다) : 방마다 home.css 에서 겉모양을 바꾼다 */
      :root {
        --home-size: 60px;
      }
      @media (max-width: 640px), (pointer: coarse) {
        :root {
          --home-size: 52px;
        }
      }
      .home-button {
        position: fixed;
        top: 20px;
        left: 20px;
        z-index: 100;
        display: grid;
        place-items: center;
        width: var(--home-size);
        height: var(--home-size);
        border-radius: 14px;
        font-size: calc(var(--home-size) * 0.5);
        line-height: 1;
        text-decoration: none;
        color: var(--home-fg, #e0e0e0);
        /* 흐림 효과 (backdrop-filter) 는 모든 화면 위에서 매 프레임 뒤 화면을 다시 흐려 느려진다 : 반투명 배경으로 대신한다 */
        background: var(--home-bg, rgba(255, 255, 255, 0.1));
        transition: background 0.3s;
        -webkit-tap-highlight-color: transparent;
        /* 방마다 모양이 달라 방을 옮길 때 그대로 두지 않고 (persist) 부드럽게 바꿔 끼운다 */
        view-transition-name: home-button;
      }
      .home-button svg {
        display: block;
      }
      @media (hover: hover) {
        .home-button:hover {
          background: var(--home-bg-hover, rgba(255, 255, 255, 0.18));
        }
      }
      .home-button:focus-visible {
        outline: 2px solid var(--home-fg, #e0e0e0);
        outline-offset: 3px;
      }
      ::view-transition-old(home-button) {
        animation: home-out 0.25s ease both;
      }
      /* 새 방의 홈 버튼은 방 전환 (0.6s) 이 끝난 뒤에 나타난다 */
      ::view-transition-new(home-button) {
        animation: home-in 0.4s 0.45s ease both;
      }
      @keyframes home-out {
        to {
          opacity: 0;
        }
      }
      @keyframes home-in {
        from {
          opacity: 0;
        }
      }
      /* 바뀌는 페이지 전체 (root) 를 크로스페이드하지 않는다 : 전체 화면 합성이 한 겹 줄어 덜 끊긴다. 이름 붙은 방 (section-*) 만 움직인다 */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      @media (prefers-reduced-motion: reduce) {
        .home-button,
        .home-button *,
        .home-button::before,
        .home-button::after {
          transition-duration: 0.01s !important;
        }
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }
    </style>
  </body>
</html>
